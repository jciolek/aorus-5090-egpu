ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{device}=="0x22e8", RUN+="/usr/bin/bash -c 'dev=/sys/bus/pci/devices/%k; gpu=${dev%.*}.0; if [ ! -r \"$gpu/device\" ]; then exit 0; fi; read -r gpu_device < \"$gpu/device\"; [ \"$gpu_device\" = \"0x2b85\" ] || exit 0; if [ -w \"$dev/driver_override\" ]; then printf \"%s\\n\" \"aorus_disabled\" > \"$dev/driver_override\"; fi; if [ -w \"$dev/driver/unbind\" ]; then printf \"%s\\n\" \"%k\" > \"$dev/driver/unbind\"; fi'"
